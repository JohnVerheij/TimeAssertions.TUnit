{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":timezone(Europe/Amsterdam)",
    "schedule:earlyMondays",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchManagers": ["nuget", "custom.regex"],
      "semanticCommitType": "deps"
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci"
    },
    {
      "description": "Auto-merge patch and minor bumps once CI passes (requires 'Allow auto-merge' to be enabled on the repo). Major bumps stay manual.",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeStrategy": "squash",
      "platformAutomerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep TUnit version literals (README Requirements line, smoketest csproj PackageReference, bug-report Issue Form placeholder) in lockstep with the central TUnit package version. Renovate updates these in the same PR that bumps Directory.Packages.props.",
      "managerFilePatterns": [
        "/^README\\.md$/",
        "/^src/TimeAssertions\\.TUnit/README\\.md$/",
        "/^tests/TimeAssertions\\.TUnit\\.SmokeTest/TimeAssertions\\.TUnit\\.SmokeTest\\.csproj$/",
        "/^\\.github/ISSUE_TEMPLATE/bug_report\\.yml$/"
      ],
      "matchStrings": [
        "TUnit (?<currentValue>\\d+\\.\\d+\\.\\d+) or later",
        "<PackageReference Include=\"TUnit\" Version=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\" />",
        "label: TUnit version[\\s\\S]*?placeholder: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "TUnit",
      "datasourceTemplate": "nuget",
      "versioningTemplate": "semver"
    }
  ]
}
