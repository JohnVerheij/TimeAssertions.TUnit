<Project>

  <!--
    Auto-extracts the section for the current <Version> from CHANGELOG.md and feeds it into
    <PackageReleaseNotes> at pack time, so the Release Notes tab on nuget.org renders the
    per-version section body verbatim rather than the literal csproj fallback. The csproj
    keeps the GitHub-release-tag URL as its <PackageReleaseNotes> fallback; the auto-extract
    overrides it whenever a matching CHANGELOG section is found.

    Failure modes are non-fatal. If CHANGELOG.md is absent, the target is skipped via its
    Condition. If CHANGELOG.md is present but has no '## [<Version>]' section, the target
    emits an MSBuild warning and leaves the csproj fallback in place. Either way `dotnet pack`
    succeeds and produces a useful Release Notes value.

    Mirrors the family pattern (Directory.Build.props for property defaults; this targets file
    is the property-side build extension that runs after the SDK has set $(Version)). Rolls to
    the other four family repos after the JsonAssertions pilot cycle.
  -->

  <UsingTask TaskName="ExtractChangelogSection"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ChangelogPath ParameterType="System.String" Required="true" />
      <Version       ParameterType="System.String" Required="true" />
      <RepositoryUrl ParameterType="System.String" Required="false" />
      <Notes         ParameterType="System.String" Output="true" />
      <Found         ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Found = false;
        Notes = string.Empty;
        if (!File.Exists(ChangelogPath))
        {
            return true;
        }
        var text = File.ReadAllText(ChangelogPath, Encoding.UTF8);
        var pattern = @"^##\s+\[" + Regex.Escape(Version) + @"\][^\r\n]*\r?\n(?<body>.*?)(?=^##\s+\[|\z)";
        var match = Regex.Match(text, pattern, RegexOptions.Multiline | RegexOptions.Singleline);
        if (!match.Success)
        {
            return true;
        }
        var body = match.Groups["body"].Value.Trim('\r', '\n', ' ', '\t');
        if (!string.IsNullOrEmpty(RepositoryUrl))
        {
            // nuget.org renders the Release Notes tab as plaintext-with-line-breaks rather
            // than rendered markdown (NuGet/NuGetGallery#8889 is the open feature request).
            // Prepending the matching GitHub Release URL gives consumers a one-click route to
            // the rendered-markdown version while keeping the extracted body inline below.
            Notes = "View the rendered release notes: " + RepositoryUrl + "/releases/tag/v" + Version + "\n\n" + body;
        }
        else
        {
            Notes = body;
        }
        Found = true;
        return true;
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="SetPackageReleaseNotesFromChangelog"
          BeforeTargets="GenerateNuspec"
          Condition="'$(IsPackable)' == 'true' AND '$(Version)' != '' AND Exists('$(MSBuildThisFileDirectory)CHANGELOG.md')">
    <ExtractChangelogSection ChangelogPath="$(MSBuildThisFileDirectory)CHANGELOG.md"
                             Version="$(Version)"
                             RepositoryUrl="$(RepositoryUrl)">
      <Output TaskParameter="Notes" PropertyName="_ChangelogNotes" />
      <Output TaskParameter="Found" PropertyName="_ChangelogFound" />
    </ExtractChangelogSection>
    <PropertyGroup Condition="'$(_ChangelogFound)' == 'true'">
      <PackageReleaseNotes>$(_ChangelogNotes)</PackageReleaseNotes>
    </PropertyGroup>
    <Warning Condition="'$(_ChangelogFound)' != 'true'"
             Text="CHANGELOG.md has no '## [$(Version)]' section; PackageReleaseNotes falls back to the csproj default." />
  </Target>

  <!--
    Renders the `*.template.*` files in this repo into their flat-text outputs (README.md, the
    packed README, the bug-report Issue Form, and the external-consumer SmokeTest csproj),
    substituting `{{TUnitVersion}}` with the version literal extracted from
    Directory.Packages.props. The render is a pure string substitution; templates are the
    human-edited source of truth and the rendered files are committed alongside them so
    `dotnet pack`, the GitHub README renderer, and the Issue Forms UI all consume flat text.

    Run via `dotnet build TimeAssertions.TUnit.slnx -t:SyncVersionRefs`. CI invokes the same
    target and fails on a non-empty `git diff` so neither a template-only edit nor a
    flat-file-only edit can land on `main`. Dependabot's TUnit bump on
    `Directory.Packages.props` is automatically reconciled into the rendered files by the
    sync-version-refs workflow, which commits the regeneration into the dependabot PR
    before merge.

    The target is deliberately decoupled from `Build`: contributors who never edit a template
    pay no cost on `dotnet build`. The CI gate is the only mandatory entry point.
  -->
  <UsingTask TaskName="SyncVersionRefsTask"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <PackagesProps ParameterType="System.String" Required="true" />
      <Templates     ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!File.Exists(PackagesProps))
        {
            Log.LogError("SyncVersionRefs: Directory.Packages.props not found at '" + PackagesProps + "'.");
            return false;
        }
        var propsText = File.ReadAllText(PackagesProps);
        var versionMatch = Regex.Match(
            propsText,
            @"<PackageVersion\s+Include=""TUnit""\s+Version=""(?<v>[^""]+)""",
            RegexOptions.IgnoreCase);
        if (!versionMatch.Success)
        {
            Log.LogError("SyncVersionRefs: could not extract <PackageVersion Include=\"TUnit\" Version=\"...\" /> from '" + PackagesProps + "'.");
            return false;
        }
        var tunitVersion = versionMatch.Groups["v"].Value;
        Log.LogMessage(MessageImportance.High, "SyncVersionRefs: TUnit version = " + tunitVersion);

        // UTF-8 without BOM. The repo's .gitattributes normalises *.md / *.yml / *.csproj to
        // LF on commit; templates are committed in that form and the substitution preserves
        // whatever line endings are in the template, so no explicit normalisation is needed.
        var noBomUtf8 = new UTF8Encoding(false);

        foreach (var t in Templates)
        {
            var src = t.GetMetadata("Identity");
            var dst = t.GetMetadata("DestinationFile");
            if (string.IsNullOrEmpty(dst))
            {
                Log.LogError("SyncVersionRefs: template '" + src + "' is missing the 'DestinationFile' metadata.");
                return false;
            }
            if (!File.Exists(src))
            {
                Log.LogError("SyncVersionRefs: template '" + src + "' does not exist.");
                return false;
            }

            var content = File.ReadAllText(src, noBomUtf8);
            content = content.Replace("{{TUnitVersion}}", tunitVersion);

            var dstDir = Path.GetDirectoryName(dst);
            if (!string.IsNullOrEmpty(dstDir) && !Directory.Exists(dstDir))
            {
                Directory.CreateDirectory(dstDir);
            }
            File.WriteAllText(dst, content, noBomUtf8);
            Log.LogMessage(MessageImportance.High, "SyncVersionRefs: wrote '" + dst + "'.");
        }
        return true;
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    Gate the body to a single project so `dotnet build TimeAssertions.TUnit.slnx
    -t:SyncVersionRefs` does not invoke the file-write logic once per project in
    parallel (which would race on the destination files). The `TimeAssertions` core
    csproj is selected because it has no dependencies on its siblings and so always
    sits at the head of the topological build order; the target body therefore runs
    exactly once per slnx-level invocation.
  -->
  <Target Name="SyncVersionRefs" Condition="'$(MSBuildProjectName)' == 'TimeAssertions'">
    <ItemGroup>
      <_SyncTemplate Include="$(MSBuildThisFileDirectory)README.template.md">
        <DestinationFile>$(MSBuildThisFileDirectory)README.md</DestinationFile>
      </_SyncTemplate>
      <_SyncTemplate Include="$(MSBuildThisFileDirectory)src\TimeAssertions.TUnit\README.template.md">
        <DestinationFile>$(MSBuildThisFileDirectory)src\TimeAssertions.TUnit\README.md</DestinationFile>
      </_SyncTemplate>
      <_SyncTemplate Include="$(MSBuildThisFileDirectory).github\ISSUE_TEMPLATE\bug_report.template.yml">
        <DestinationFile>$(MSBuildThisFileDirectory).github\ISSUE_TEMPLATE\bug_report.yml</DestinationFile>
      </_SyncTemplate>
      <_SyncTemplate Include="$(MSBuildThisFileDirectory)tests\TimeAssertions.TUnit.SmokeTest\TimeAssertions.TUnit.SmokeTest.csproj.template">
        <DestinationFile>$(MSBuildThisFileDirectory)tests\TimeAssertions.TUnit.SmokeTest\TimeAssertions.TUnit.SmokeTest.csproj</DestinationFile>
      </_SyncTemplate>
    </ItemGroup>
    <SyncVersionRefsTask
        PackagesProps="$(MSBuildThisFileDirectory)Directory.Packages.props"
        Templates="@(_SyncTemplate)" />
  </Target>

</Project>
